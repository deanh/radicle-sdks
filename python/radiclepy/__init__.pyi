# ── Exceptions (hierarchy: all inherit from Error) ───────────────────────────

class Error(Exception): ...
class StorageError(Error): ...
class RepositoryError(Error): ...
class GitError(Error): ...
class DatabaseError(Error): ...
class IdentityError(Error): ...
class SignerError(Error): ...
class PolicyError(Error): ...
class CobError(Error): ...

# ── Identifier validators (ValueError on invalid input) ──────────────────────

def parse_repo_id(value: str) -> RepoId: ...
def parse_did(value: str) -> Did: ...
def parse_node_id(value: str) -> NodeId: ...
def parse_oid(value: str) -> Oid: ...
def parse_object_id(value: str) -> ObjectId: ...

# ── Handles ──────────────────────────────────────────────────────────────────

class Home:
    """Filesystem home for a Radicle profile (`RAD_HOME` / `~/.radicle`)."""

    def __init__(self, path: str) -> None: ...
    @classmethod
    def load(cls, path: str) -> Home: ...
    @classmethod
    def resolve(cls) -> Home:
        """Resolve from `RAD_HOME`, else `~/.radicle`."""
        ...
    @property
    def path(self) -> str: ...
    def __repr__(self) -> str: ...

class Aliases:
    """Lookup facade over the profile's alias stores — NOT a collection.

    Upstream only supports `get(node_id)` and `reverse_lookup(alias)`;
    there is no enumeration.
    """

    def get(self, node_id: NodeId) -> str | None: ...
    def reverse_lookup(self, alias: Alias) -> dict[str, list[NodeId]]: ...
    def __repr__(self) -> str: ...

class Signer:
    """Radicle signer: unencrypted keystore, `RAD_PASSPHRASE`, or ssh-agent."""

    @property
    def did(self) -> Did: ...
    @property
    def node_id(self) -> NodeId: ...
    def __repr__(self) -> str: ...

class Profile:
    """A local Radicle profile (keys, config, storage)."""

    @classmethod
    def load(cls) -> Profile:
        """Load from `RAD_HOME` or `~/.radicle`."""
        ...
    @classmethod
    def init(cls, home_path: str, alias: str, passphrase: str | None = None) -> Profile:
        """Initialize a new profile with a **secure random seed** (OS RNG).

        Deterministic seeding is not part of the shipped API (PLAN §5.7):
        `Profile._from_seed` exists only in builds with the `test-helpers`
        cargo feature and is absent from release wheels.
        """
        ...
    @property
    def did(self) -> Did: ...
    @property
    def node_id(self) -> NodeId: ...
    @property
    def home(self) -> Home: ...
    @property
    def aliases(self) -> Aliases: ...
    def signer(self) -> Signer: ...
    def __repr__(self) -> str: ...

# ── Storage & repository (Phase 2) ───────────────────────────────────────────

class Storage:
    """Repository storage for a Radicle home (upstream `radicle::Storage`)."""

    @classmethod
    def from_profile(cls, profile: Profile) -> Storage:
        """Primary constructor: the storage of `profile`."""
        ...
    @classmethod
    def open(cls, path: str, alias: Alias, node_id: NodeId) -> Storage:
        """Low-level ctor: open/create storage with an explicit git identity.

        Raises `ValueError` for invalid `alias`/`node_id`, `StorageError` on
        operational failure.
        """
        ...
    @property
    def path(self) -> str: ...
    def repository(self, rid: RepoId) -> Repository:
        """Open a repository for reading (raises `RepositoryError` if absent)."""
        ...
    def contains(self, rid: RepoId) -> bool: ...
    def repositories(self) -> list[RepoId]:
        """Raises `StorageError` on storage failures (not an empty list)."""
        ...
    def __repr__(self) -> str: ...

class Repository:
    """Read-only repository handle; reopens storage per operation.

    Mutations arrive only via explicit write APIs (Phase 5).
    """

    @property
    def rid(self) -> RepoId: ...
    @property
    def head(self) -> HeadInfo: ...
    def identity(self) -> ProjectDoc:
        """Verified canonical identity document (`IdentityError` on failure)."""
        ...
    def description(self) -> str:
        """Raises `IdentityError` on identity load/verification failures."""
        ...
    def branches(self) -> list[str]: ...
    def branch_head(self, name: str) -> Oid | None:
        """`None` only when the branch does not exist; `ValueError` for invalid
        names, `GitError` for other libgit2 failures."""
        ...
    def tags(self) -> list[TagInfo]: ...
    def rev_parse(self, rev: str) -> Oid:
        """Raises `GitError` for invalid OR unresolved revisions."""
        ...
    def commit(self, oid: Oid) -> Commit: ...
    def tree(self, oid: Oid) -> Tree: ...
    def blob(self, oid: Oid) -> bytes: ...
    def history(self, rev: str, *, limit: int = 100, offset: int = 0) -> HistoryPage:
        """Bounded history page (libgit2 default walk order; see FINDINGS-02 S7).

        `1 <= limit <= 1000` (larger limits are clamped to 1000; `limit == 0`
        raises `ValueError`).
        """
        ...
    def remotes(self) -> list[RemoteInfo]: ...
    def __repr__(self) -> str: ...

# ── Value classes (immutable; bytes-first fields) ────────────────────────────

class HeadInfo:
    """Repository head: qualified ref name + OID."""

    @property
    def name(self) -> str: ...
    @property
    def oid(self) -> Oid: ...
    def __repr__(self) -> str: ...

class Commit:
    """A git commit. Bytes-first identity/message fields; `*_str` is lossy."""

    @property
    def oid(self) -> Oid: ...
    @property
    def tree(self) -> Oid: ...
    @property
    def parents(self) -> list[Oid]: ...
    @property
    def author_name(self) -> bytes: ...
    @property
    def author_name_str(self) -> str: ...
    @property
    def author_email(self) -> bytes: ...
    @property
    def author_email_str(self) -> str: ...
    @property
    def author_time(self) -> int: ...
    @property
    def author_offset_min(self) -> int: ...
    @property
    def committer_name(self) -> bytes: ...
    @property
    def committer_name_str(self) -> str: ...
    @property
    def committer_email(self) -> bytes: ...
    @property
    def committer_email_str(self) -> str: ...
    @property
    def committer_time(self) -> int: ...
    @property
    def committer_offset_min(self) -> int: ...
    @property
    def message(self) -> bytes: ...
    @property
    def message_str(self) -> str: ...
    @property
    def encoding(self) -> str | None: ...
    def __repr__(self) -> str: ...

class TreeEntry:
    """One tree entry. Ordering: canonical git order (never re-sorted)."""

    @property
    def name(self) -> bytes: ...
    @property
    def name_str(self) -> str: ...
    @property
    def kind(self) -> str | None:
        """`"blob" | "tree" | "commit" | None`; symlinks are "blob" (mode 0o120000)."""
        ...
    @property
    def mode(self) -> int: ...
    @property
    def oid(self) -> Oid: ...
    def __repr__(self) -> str: ...

class Tree:
    """A git tree; `entries` is in canonical git tree order."""

    @property
    def oid(self) -> Oid: ...
    @property
    def entries(self) -> list[TreeEntry]: ...
    def __len__(self) -> int: ...
    def __repr__(self) -> str: ...

class TagInfo:
    """Tag with explicit raw/peeled distinction.

    Peeling applies only to annotated tags; for lightweight tags
    `peeled == target`. Peeled = fully resolved, not commit-specific.
    """

    @property
    def name(self) -> str: ...
    @property
    def target(self) -> Oid: ...
    @property
    def kind(self) -> str: ...
    @property
    def peeled(self) -> Oid: ...
    @property
    def peeled_kind(self) -> str:
        """`"commit" | "tree" | "blob"` (a fully-peeled target is never a tag)."""
        ...
    def __repr__(self) -> str: ...

class RemoteInfo:
    """A remote tracked by the repository (upstream signed refs)."""

    @property
    def fetcher(self) -> NodeId: ...
    @property
    def heads(self) -> list[str]: ...
    def __repr__(self) -> str: ...

class ProjectDoc:
    """Canonical project identity document (verified at load)."""

    @property
    def name(self) -> str: ...
    @property
    def description(self) -> str: ...
    @property
    def default_branch(self) -> str: ...
    @property
    def version(self) -> int: ...
    @property
    def delegates(self) -> list[Did]: ...
    @property
    def threshold(self) -> int: ...
    @property
    def visibility(self) -> str: ...
    @property
    def commit(self) -> Oid: ...
    @property
    def blob(self) -> Oid: ...
    def __repr__(self) -> str: ...

class HistoryPage:
    """One page of commit history (libgit2 default revwalk order)."""

    @property
    def name(self) -> str:
        """Revision expression as passed to `history()` (not normalized)."""
        ...
    @property
    def head(self) -> Oid: ...
    @property
    def oids(self) -> list[Oid]: ...
    @property
    def offset(self) -> int: ...
    @property
    def has_more(self) -> bool: ...
    def __repr__(self) -> str: ...

__version__: str
