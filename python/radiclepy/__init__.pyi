# ── Handles ──────────────────────────────────────────────────────────────────

class Home:
    """Filesystem home for a Radicle profile (`RAD_HOME` / `~/.radicle`)."""

    def __init__(self, path: str | _PathLike[str]) -> None: ...
    @classmethod
    def load(cls, path: str | _PathLike[str]) -> Home: ...
    @classmethod
    def resolve(cls) -> Home:
        """Resolve from `RAD_HOME`, else `~/.radicle`."""
        ...
    @property
    def path(self) -> str: ...
    def __repr__(self) -> str: ...

class Aliases:
    """Lookup facade over the profile's alias stores — NOT a collection.

    Upstream only supports `get(node_id)` and `reverse_lookup(alias)`;
    there is no enumeration.
    """

    def get(self, node_id: NodeId) -> str | None: ...
    def reverse_lookup(self, alias: Alias) -> dict[str, list[NodeId]]: ...
    def __repr__(self) -> str: ...

class Signer:
    """Radicle signer: unencrypted keystore, `RAD_PASSPHRASE`, or ssh-agent."""

    @property
    def did(self) -> Did: ...
    @property
    def node_id(self) -> NodeId: ...
    def __repr__(self) -> str: ...

class Profile:
    """A local Radicle profile (keys, config, storage)."""

    @classmethod
    def load(cls) -> Profile:
        """Load from `RAD_HOME` or `~/.radicle`."""
        ...
    @classmethod
    def init(cls, home_path: str | _PathLike[str], alias: str, passphrase: str | None = None) -> Profile:
        """Initialize a new profile with a **secure random seed** (OS RNG).

        Deterministic seeding is not part of the shipped API (PLAN §5.7):
        `Profile._from_seed` exists only in builds with the `test-helpers`
        cargo feature and is absent from release wheels.
        """
        ...
    @property
    def did(self) -> Did: ...
    @property
    def node_id(self) -> NodeId: ...
    @property
    def home(self) -> Home: ...
    @property
    def storage(self) -> Storage: ...
    @property
    def aliases(self) -> Aliases: ...
    def signer(self) -> Signer: ...
    def policy_store(self) -> PolicyStore:
        """Read-write policy store of this profile's home (Phase 3)."""
        ...
    def routing_store(self) -> RoutingStore:
        """Read-only routing store of this profile's home (Phase 3)."""
        ...
    def __repr__(self) -> str: ...

# ── Storage & repository (Phase 2) ───────────────────────────────────────────

class Storage:
    """Repository storage for a Radicle home (upstream `radicle::Storage`)."""

    @classmethod
    def from_profile(cls, profile: Profile) -> Storage:
        """Primary constructor: the storage of `profile`."""
        ...
    @classmethod
    def open(cls, path: str | _PathLike[str], alias: Alias, node_id: NodeId) -> Storage:
        """Low-level ctor: open/create storage with an explicit git identity.

        Raises `ValueError` for invalid `alias`/`node_id`, `StorageError` on
        operational failure.
        """
        ...
    @property
    def path(self) -> str: ...
    def repository(self, rid: RepoId) -> Repository:
        """Open a repository for reading (raises `RepositoryError` if absent)."""
        ...
    def contains(self, rid: RepoId) -> bool: ...
    def __contains__(self, rid: RepoId) -> bool: ...
    def repositories(self) -> list[RepoId]:
        """Raises `StorageError` on storage failures (not an empty list)."""
        ...
    def __repr__(self) -> str: ...

class Repository:
    """Read-only repository handle; reopens storage per operation.

    Mutations arrive only via explicit write APIs (Phase 5).
    """

    @property
    def rid(self) -> RepoId: ...
    @property
    def head(self) -> HeadInfo: ...
    def identity(self) -> ProjectDoc:
        """Verified canonical identity document (`IdentityError` on failure)."""
        ...
    def description(self) -> str:
        """Raises `IdentityError` on identity load/verification failures."""
        ...
    def branches(self) -> list[str]: ...
    def branch_head(self, name: str) -> Oid | None:
        """`None` only when the branch does not exist; `ValueError` for invalid
        names, `GitError` for other libgit2 failures."""
        ...
    def tags(self) -> list[TagInfo]: ...
    def rev_parse(self, rev: str) -> Oid:
        """Raises `GitError` for invalid OR unresolved revisions."""
        ...
    def commit(self, oid: Oid) -> Commit: ...
    def tree(self, oid: Oid) -> Tree: ...
    def blob(self, oid: Oid) -> bytes: ...
    def history(self, rev: str, *, limit: int = 100, offset: int = 0) -> HistoryPage:
        """Bounded history page (libgit2 default walk order; see FINDINGS-02 S7).

        Binding-validated (`ValueError`): `1 <= limit <= 1000` (larger limits
        clamped to 1000; `limit < 1` raises, negatives included) and
        `offset >= 0`.
        """
        ...
    def remotes(self) -> list[RemoteInfo]: ...

    # ── Writes (Phase 5, PLAN §3): 1:1 upstream; only sign_refs takes a signer.
    def set_default_branch_to_canonical_head(self) -> SetHead: ...
    def set_identity_head(self) -> Oid: ...
    def set_remote_identity_root(self, remote: NodeId) -> Oid: ...
    def sign_refs(self, signer: Signer) -> SignedRefs: ...
    def __repr__(self) -> str: ...

