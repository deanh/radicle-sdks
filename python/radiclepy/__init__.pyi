    @property
    def peeled_kind(self) -> Literal['commit', 'tree', 'blob', 'any', 'unknown']:
        """`"commit" | "tree" | "blob"` (a fully-peeled target is never a tag)."""
        ...
    def __repr__(self) -> str: ...

