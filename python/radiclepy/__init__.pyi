# ── Policy & routing (Phase 3) ───────────────────────────────────────────────

class PolicyStore:
    """Follow/seed policy store (upstream `node::policy::Store`).

    Own sqlite file (`<home>/node/policies.db`). Reads are always available;
    writes require a read-write handle (`from_profile` / `open`); a read-only
    handle (`reader`) raises `StorageError` on writes.
    """

    @classmethod
    def from_profile(cls, profile: Profile) -> PolicyStore: ...
    @classmethod
    def reader(cls, profile: Profile) -> PolicyStore:
        """Read-only handle; many concurrent readers (no locking)."""
        ...
    @classmethod
    def open(cls, path: str | _PathLike[str]) -> PolicyStore: ...
    @property
    def path(self) -> str: ...
    def follow(self, node_id: NodeId, *, alias: str | None = None) -> bool: ...
    def unfollow(self, node_id: NodeId) -> bool: ...
    def seed(self, rid: RepoId, *, scope: Literal['all', 'followed'] = "all") -> bool: ...
    def unseed(self, rid: RepoId) -> bool: ...
    def set_follow_policy(self, node_id: NodeId, policy: Literal['allow', 'block']) -> bool: ...
    def set_seed_policy(self, rid: RepoId, policy: Literal['allow', 'block']) -> bool: ...
    def unblock_rid(self, rid: RepoId) -> bool: ...
    def unblock_nid(self, node_id: NodeId) -> bool: ...
    def is_following(self, node_id: NodeId) -> bool: ...
    def is_seeding(self, rid: RepoId) -> bool: ...
    def is_blocked(self, node_id: NodeId) -> bool: ...
    def follow_policy(self, node_id: NodeId) -> FollowPolicyInfo | None: ...
    def seed_policy(self, rid: RepoId) -> SeedPolicyInfo | None: ...
    def follow_policies(self) -> list[FollowPolicyInfo]: ...
    def seed_policies(self) -> list[SeedPolicyInfo]: ...
    def nodes_by_alias(self, alias: str) -> list[tuple[NodeId, str]]:
        """FUZZY (substring, case-insensitive) alias lookup — upstream LIKE."""
        ...
    def __repr__(self) -> str: ...

