{
  "name": "radicle-sdk",
  "version": "0.1.2",
  "description": "TypeScript SDK for local signed Radicle project, issue and patch workflows",
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://radicle.network/nodes/hdh.radicle.garden/rad%3Az27dDy6sppkZDG8qYcySVX9Qn5jNg"
  },
  "homepage": "https://radicle.network/nodes/hdh.radicle.garden/rad%3Az27dDy6sppkZDG8qYcySVX9Qn5jNg",
  "bugs": {
    "url": "https://radicle.network/nodes/hdh.radicle.garden/rad%3Az27dDy6sppkZDG8qYcySVX9Qn5jNg/issues"
  },
  "keywords": [
    "radicle",
    "git",
    "sdk",
    "code-collaboration"
  ],
  "type": "module",
  "engines": {
    "node": ">=26.5.0"
  },
  "exports": {
    ".": {
      "types": "./node/dist/index.d.ts",
      "import": "./node/dist/index.js"
    }
  },
  "files": [
    "node/dist",
    "node/README.md",
    "node/AGENT.md",
    "node/API.md",
    "node/CHANGELOG.md",
    "LICENSE-MIT",
    "LICENSE-APACHE",
    "THIRD-PARTY-NOTICES.md"
  ],
  "scripts": {
    "build:native": "napi build --release --platform --manifest-path node/native/Cargo.toml --output-dir node/dist --js native.cjs --dts native.d.cts -- --locked",
    "clean": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('node/dist', { recursive: true, force: true });\"",
    "build": "npm run clean && npm run build:native && tsc -p node/tsconfig.json",
    "prepare": "npm run build",
    "prepublishOnly": "node scripts/release/refuse-bare-publish.mjs",
    "test": "node --test node/test/*.test.mjs",
    "check": "tsc --noEmit -p node/tsconfig.test.json",
    "format": "prettier --write \"node/src/**/*.ts\" \"node/test/**/*.{mjs,ts}\" \"examples/*.mjs\"",
    "format:check": "prettier --check \"node/src/**/*.ts\" \"node/test/**/*.{mjs,ts}\" \"examples/*.mjs\""
  },
  "devDependencies": {
    "@napi-rs/cli": "3.10.8",
    "@types/node": "^26.0.0",
    "prettier": "3.6.2",
    "typescript": "^5.9.3"
  },
  "napi": {
    "binaryName": "radicle-sdk",
    "targets": [
      "x86_64-unknown-linux-gnu",
      "aarch64-apple-darwin"
    ]
  }
}
